# Optional. Without credentials all deterministic ingestion still works.
# Zero-cost route: a Gemini key from a project marked Free Tier (no billing).
# Windows: double-click setup-free-ai.cmd instead of editing this file.
FINN_LLM_API_KEY=
FINN_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FINN_MODEL_T1=
FINN_MODEL_T2=gemini-3.5-flash-lite
# Enter current provider prices. Unknown pricing is shown as unknown, not zero.
FINN_T1_INPUT_USD_PER_MILLION=
FINN_T1_OUTPUT_USD_PER_MILLION=
FINN_T2_INPUT_USD_PER_MILLION=
FINN_T2_OUTPUT_USD_PER_MILLION=
BRAVE_SEARCH_API_KEY=
# Turn on unattended polling while the backend process is running.
FINN_POLL_INTERVAL_SECONDS=0
# Required before exposing this single-user prototype on a public server.
FINN_API_TOKEN=
FINN_CORS_ORIGINS=
